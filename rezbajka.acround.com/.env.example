# Скопируйте в .env — docker-compose.yml подхватывает его сам.
# Без .env или без этой строки в нём: REZBAJKA_DOMAIN берётся из
# docker-compose.yml по умолчанию — https://rezbajka.acround.com, тот же
# адрес, что зашит в canonical/hreflang/OG при сборке. Ничего не меняется.
#
# Для локального теста — протокол и хост, без слэша на конце:
REZBAJKA_DOMAIN=http://localhost:8082

# Куда форма «Заказать» шлёт заявку — Webhook node в n8n, Production URL.
# Не задан или пуст — форма честно говорит, что приём заявок не подключён.
N8N_WEBHOOK_URL=
